# ─────────────────────────────────────────────────────────────────────────────
# DIO Explorer MCP Server — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ─────────────────────────────────────────────────────────────────────────────

# Modo de transporte: "stdio" (padrão, local) ou "http" (remoto)
MCP_TRANSPORT=stdio

# Porta e host para o modo HTTP
PORT=3100
HOST=0.0.0.0

# API Key para autenticação Bearer (deixe vazio para desabilitar auth em dev)
# Quando definida, toda requisição deve incluir: Authorization: Bearer <API_KEY>
API_KEY=

# Origens CORS permitidas (CSV). Use "*" para liberar tudo em dev.
# Ex produção: https://meusite.com,https://app.meusite.com
CORS_ORIGINS=*
